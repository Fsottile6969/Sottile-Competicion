PORT=3000

# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_clave_aleatoria_de_96_chars

# Admin por defecto
ADMIN_EMAIL=admin@taller.com
ADMIN_PASSWORD=cambiar_password_seguro

# Google OAuth — obtener en https://console.cloud.google.com
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# CORS — orígenes permitidos separados por coma
ALLOWED_ORIGINS=https://tu-dominio.onrender.com,http://localhost:3000

# Cifrado DB — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=clave_hex_de_exactamente_64_caracteres

# VAPID para push notifications — generar con: node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
VAPID_EMAIL=mailto:admin@taller.com

# WhatsApp del taller (formato internacional sin + ni espacios)
TALLER_WHATSAPP=5491112345678
TALLER_NOMBRE=Taller Sottile-Competicion

# Render (se setea automáticamente en Render)
# RENDER_EXTERNAL_URL=https://tu-app.onrender.com
# NODE_ENV=production
